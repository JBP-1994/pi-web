{
  // 统一用 ESLint --fix 做保存时格式化，避免 Prettier/内置 formatter 各自改格式产生额外 diff
  "editor.formatOnSave": false,
  "editor.defaultFormatter": null,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.trimAutoWhitespace": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  // 语言覆盖：确保 JS/TS 文件不被其他 formatter 劫持
  "[javascript]": { "editor.defaultFormatter": null },
  "[javascriptreact]": { "editor.defaultFormatter": null },
  "[typescript]": { "editor.defaultFormatter": null },
  "[typescriptreact]": { "editor.defaultFormatter": null },
  "[json]": { "editor.tabSize": 2 },
  "[jsonc]": { "editor.tabSize": 2 }
}
